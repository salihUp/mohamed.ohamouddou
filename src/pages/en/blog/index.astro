---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Section from '~/components/ui/Section.astro';
import BlogCard from '~/components/cards/BlogCard.astro';
import { tString } from '~/i18n';

const locale = 'en' as const;

const isProd = import.meta.env.PROD;
const all = await getCollection('blog', (e) => {
  const fromLocale = e.id.startsWith('en/');
  const visible = !e.data.draft || !isProd;
  return fromLocale && visible;
});
const sorted = [...all].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Base
  locale={locale}
  title={`${tString(locale, 'blog.title')} — Mohamed Ohamouddou`}
  description={tString(locale, 'blog.lead')}
>
  <Section
    eyebrow={tString(locale, 'blog.eyebrow')}
    title={tString(locale, 'blog.title')}
    lead={tString(locale, 'blog.lead')}
  >
    {sorted.length === 0 ? (
      <p class="empty">{tString(locale, 'blog.empty')}</p>
    ) : (
      <div class="grid">
        {sorted.map((entry) => <BlogCard entry={entry} locale={locale} />)}
      </div>
    )}
  </Section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
  }
  .empty {
    color: var(--color-muted);
    font-size: 0.95rem;
    border: 1px dashed var(--color-line);
    padding: 1.25rem;
    border-radius: var(--radius-card);
  }
</style>
