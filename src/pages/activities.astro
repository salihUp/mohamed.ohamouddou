---
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Section from '~/components/ui/Section.astro';
import ActivityCard from '~/components/cards/ActivityCard.astro';
import { tString } from '~/i18n';
import { groupBy } from '~/lib/format';

const locale = 'fr' as const;

const all = await getCollection('activities');
const sorted = [...all].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const grouped = groupBy(sorted, (e) => new Date(e.data.date).getFullYear());
const years = [...grouped.keys()].sort((a, b) => b - a);
---

<Base
  locale={locale}
  title={`${tString(locale, 'activities.title')} — Mohamed Ohamouddou`}
  description={tString(locale, 'activities.lead')}
>
  <Section
    eyebrow={tString(locale, 'activities.eyebrow')}
    title={tString(locale, 'activities.title')}
    lead={tString(locale, 'activities.lead')}
  >
    {sorted.length === 0 ? (
      <p class="empty">{tString(locale, 'activities.empty')}</p>
    ) : (
      years.map((year) => (
        <div class="year-group">
          <h3 class="year-label">{year}</h3>
          <div class="grid">
            {grouped.get(year)!.map((entry) => <ActivityCard entry={entry} locale={locale} />)}
          </div>
        </div>
      ))
    )}
  </Section>
</Base>

<style>
  .year-group { margin-bottom: 2.25rem; }
  .year-label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
    margin: 0 0 1rem;
    letter-spacing: 0.06em;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
  }
  .empty {
    color: var(--color-muted);
    font-size: 0.95rem;
    border: 1px dashed var(--color-line);
    padding: 1.25rem;
    border-radius: var(--radius-card);
  }
</style>
