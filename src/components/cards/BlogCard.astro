---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '~/i18n';
import { localizedPath } from '~/i18n';
import { formatDate } from '~/lib/format';

interface Props {
  entry: CollectionEntry<'blog'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const d = entry.data;
const slug = entry.id.replace(/^(fr|en)\//, '').replace(/\.(md|mdx)$/, '');
const href = localizedPath(`/blog/${slug}`, locale);
---

<article class="card blogcard">
  <a class="blog-link" href={href}>
    <header class="blog-head">
      <span class="date">{formatDate(d.date, locale)}</span>
      {d.tags.length > 0 && (
        <ul class="tags">
          {d.tags.slice(0, 3).map((t) => <li class="chip">#{t}</li>)}
        </ul>
      )}
    </header>
    <h3 class="blog-title underline-grow">{d.title}</h3>
    <p class="blog-excerpt">{d.excerpt}</p>
  </a>
</article>

<style>
  .blogcard { padding: 0; overflow: hidden; }
  .blog-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem 1.35rem;
    color: inherit;
  }
  .blog-head { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }
  .tags { list-style: none; display: inline-flex; gap: 0.35rem; padding: 0; margin: 0; }
  .blog-title { font-size: 1.15rem; font-weight: 700; line-height: 1.3; margin: 0; width: max-content; max-width: 100%; }
  .blog-excerpt { font-size: 0.95rem; color: var(--color-ink-soft); line-height: 1.55; margin: 0; }
</style>
