---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '~/i18n';
import { tString } from '~/i18n';
import { joinAuthorsHTML, parseAuthors } from '~/lib/format';

interface Props {
  entry: CollectionEntry<'publications'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const d = entry.data;
const authors = joinAuthorsHTML(parseAuthors(d.authors));
const abstract = locale === 'fr' ? d.abstract_fr : d.abstract_en;
const scholarSearch = `https://scholar.google.com/scholar?q=${encodeURIComponent(d.title)}`;
const primaryHref = d.url ?? (d.doi ? `https://doi.org/${d.doi}` : (d.pdf ?? d.arxiv ?? scholarSearch));

const links: { icon: string; label: string; href: string }[] = [];
if (d.pdf) links.push({ icon: 'lucide:file-text', label: 'PDF', href: d.pdf });
if (d.doi) links.push({ icon: 'lucide:link-2', label: 'DOI', href: `https://doi.org/${d.doi}` });
if (d.arxiv) links.push({ icon: 'lucide:book-open', label: 'arXiv', href: d.arxiv });
if (d.code) links.push({ icon: 'lucide:code-2', label: 'Code', href: d.code });
if (d.slides) links.push({ icon: 'lucide:presentation', label: 'Slides', href: d.slides });
if (links.length === 0) {
  links.push({ icon: 'simple-icons:googlescholar', label: 'Scholar', href: scholarSearch });
}
---

<article class="card pub" data-featured={d.featured ? 'true' : undefined}>
  <aside class="pub-side">
    <span class="year">{d.year}</span>
    <span class="chip type-chip">{tString(locale, `publications.type.${d.type}`)}</span>
    {d.featured && (
      <span class="featured" aria-label={tString(locale, 'common.featured')}>
        <Icon name="lucide:sparkle" width="11" height="11" />
        <span>{tString(locale, 'common.featured')}</span>
      </span>
    )}
  </aside>

  <div class="pub-body">
    <h3 class="pub-title">
      <a href={primaryHref} target="_blank" rel="noopener noreferrer" class="title-link">
        {d.title}
      </a>
    </h3>

    <p class="pub-authors" set:html={authors}></p>

    {d.venue && (
      <p class="pub-venue">
        <em>{d.venue}</em>{d.volume && <span>, vol. {d.volume}</span>}{d.number && <span> ({d.number})</span>}{d.pages && <span>, pp. {d.pages}</span>}.
      </p>
    )}

    {abstract && (
      <details class="pub-abstract">
        <summary>{tString(locale, 'publications.abstract')}</summary>
        <p>{abstract}</p>
      </details>
    )}

    <ul class="pub-links">
      {links.map((l) => (
        <li>
          <a href={l.href} target="_blank" rel="noopener noreferrer" class="chip pub-link">
            <Icon name={l.icon} width="13" height="13" />
            <span>{l.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</article>

<style>
  .pub {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 1.5rem;
    position: relative;
  }
  .pub[data-featured]::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
    background: linear-gradient(135deg,
      color-mix(in srgb, var(--color-accent) 5%, transparent) 0%,
      transparent 60%);
    pointer-events: none;
  }
  @media (min-width: 720px) {
    .pub { grid-template-columns: 8rem 1fr; gap: 1.5rem; }
  }

  .pub-side {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
    align-items: center;
    flex-wrap: wrap;
  }
  @media (min-width: 720px) {
    .pub-side {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.45rem;
    }
  }

  .year {
    font-weight: 800;
    font-size: clamp(1.75rem, 3.2vw, 2.4rem);
    letter-spacing: -0.045em;
    line-height: 0.9;
    color: var(--color-ink);
    font-feature-settings: 'tnum';
  }
  .type-chip {
    color: var(--color-accent-strong);
    border-color: color-mix(in srgb, var(--color-accent) 35%, var(--color-line));
  }
  .featured {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: #fff;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .pub-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
  }
  .pub-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.32;
    margin: 0;
    letter-spacing: -0.012em;
  }
  .title-link {
    color: var(--color-ink);
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 320ms ease, color 220ms ease;
  }
  .title-link:hover {
    color: var(--color-accent-strong);
    background-size: 100% 1px;
  }
  .pub-authors {
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    margin: 0;
    line-height: 1.5;
  }
  .pub-authors :global(strong) { color: var(--color-ink); font-weight: 600; }
  .pub-venue {
    font-size: 0.88rem;
    color: var(--color-muted);
    margin: 0;
  }
  .pub-abstract {
    margin-top: 0.2rem;
    font-size: 0.92rem;
    color: var(--color-ink-soft);
  }
  .pub-abstract summary {
    cursor: pointer;
    color: var(--color-accent-strong);
    font-weight: 500;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .pub-abstract summary::-webkit-details-marker { display: none; }
  .pub-abstract summary::before {
    content: '+';
    display: inline-block;
    width: 1em;
    text-align: center;
    transition: transform 220ms ease;
  }
  .pub-abstract[open] summary::before { content: '−'; }
  .pub-abstract p { margin-top: 0.55rem; line-height: 1.55; }

  .pub-links {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pub-link {
    cursor: pointer;
    transition: border-color 180ms ease, color 180ms ease, background 180ms ease;
  }
  .pub-link:hover {
    border-color: var(--color-ink);
    color: #fff;
    background: var(--color-ink);
  }
</style>
