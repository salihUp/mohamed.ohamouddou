---
import { getCollection } from 'astro:content';
import type { Locale } from '~/i18n';
import { tArray, tString } from '~/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const publications = await getCollection('publications');
const courses = await getCollection('courses');

const currentYear = new Date().getFullYear();
const activeCourses = courses.filter((c) => {
  const end = c.data.year_end ?? currentYear;
  return end >= currentYear;
});

const earliestCourseYear = courses.reduce(
  (min, c) => Math.min(min, c.data.year_start),
  currentYear,
);
const yearsTeaching = Math.max(1, currentYear - earliestCourseYear + 1);

const researchCount = tArray(locale, 'about.research.items').length;

const stats = [
  { value: publications.length, label: tString(locale, 'home.highlights.publications') },
  { value: activeCourses.length, label: tString(locale, 'home.highlights.courses') },
  { value: `${yearsTeaching}+`, label: tString(locale, 'home.highlights.years') },
  { value: researchCount, label: tString(locale, 'home.highlights.areas') },
];
---

<section class="highlights">
  <div class="container-prose">
    <ul class="grid" data-reveal>
      {stats.map((s, i) => (
        <li class="stat" style={`--reveal-delay: ${i * 60}ms`}>
          <span class="value">{s.value}</span>
          <span class="label">{s.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .highlights {
    padding-block: clamp(2rem, 4vw, 3.25rem);
    border-block: 1px solid var(--color-line);
    background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-bg-soft) 100%);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
  }
  @media (min-width: 720px) {
    .grid { grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    align-items: flex-start;
    border-left: 2px solid var(--color-accent);
    padding-left: 1rem;
  }
  .value {
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 2.75rem);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
  }
  .label {
    font-size: 0.78rem;
    color: var(--color-ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
  }
</style>
