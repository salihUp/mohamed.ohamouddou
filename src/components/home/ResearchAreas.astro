---
import type { Locale } from '~/i18n';
import { tArray, tString } from '~/i18n';
import Section from '~/components/ui/Section.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const items = tArray(locale, 'about.research.items');

const extraTags = locale === 'fr'
  ? ['TinyML', 'Edge AI', 'Knowledge Distillation', 'Cortex-M', 'Federated Learning', 'IoT']
  : ['TinyML', 'Edge AI', 'Knowledge Distillation', 'Cortex-M', 'Federated Learning', 'IoT'];
---

<Section
  eyebrow={tString(locale, 'home.focus.eyebrow')}
  title={tString(locale, 'home.focus.title')}
  lead={tString(locale, 'home.focus.lead')}
>
  <div class="research-grid" data-reveal style="--reveal-delay: 100ms">
    <ul class="areas">
      {items.map((item, i) => (
        <li style={`--n: ${i}`}>
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <span class="text">{item}</span>
        </li>
      ))}
    </ul>
    <div class="tags-wrap">
      <p class="tags-label">Mots-clés</p>
      <ul class="tags">
        {extraTags.map((tag) => <li class="chip chip-accent">{tag}</li>)}
      </ul>
    </div>
  </div>
</Section>

<style>
  .research-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 800px) {
    .research-grid { grid-template-columns: 1.5fr 1fr; gap: 3rem; }
  }

  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .areas li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--color-line);
    transition: border-color 220ms ease, padding-left 220ms ease;
  }
  .areas li:hover {
    border-color: var(--color-ink);
    padding-left: 0.4rem;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
    letter-spacing: 0.08em;
  }
  .text {
    font-size: 1.05rem;
    color: var(--color-ink);
    font-weight: 500;
  }

  .tags-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    align-self: start;
    padding: 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-bg-soft);
  }
  .tags-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }
  .tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
