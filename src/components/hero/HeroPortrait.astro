---
interface Props {
  src: string;
  alt: string;
}
const { src, alt } = Astro.props;
---

<div class="portrait-wrap">
  <div class="portrait-frame">
    <div class="portrait-circle">
      <img src={src} alt={alt} loading="eager" decoding="async" />
    </div>
  </div>
</div>

<style>
  .portrait-wrap {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .portrait-frame {
    width: clamp(14rem, 32vw, 24rem);
    aspect-ratio: 1 / 1;
    border-radius: 999px;
    border: 1.5px solid #cfcfd4;
    padding: clamp(0.55rem, 1.3vw, 0.8rem);
    background: var(--color-bg);
    box-sizing: border-box;
  }
  .portrait-circle {
    width: 100%;
    height: 100%;
    border-radius: 999px;
    overflow: hidden;
    background: var(--color-bg-soft);
  }
  .portrait-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    filter: grayscale(1) contrast(1.02);
    display: block;
  }
</style>
