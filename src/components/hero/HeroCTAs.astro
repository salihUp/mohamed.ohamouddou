---
interface CTA {
  label: string;
  href: string;
}

interface Props {
  primary: CTA;
  secondary: CTA;
}

const { primary, secondary } = Astro.props;
---

<div class="ctas">
  <a class="btn btn-filled" href={primary.href}>{primary.label}</a>
  <a class="btn btn-outline" href={secondary.href}>{secondary.label}</a>
</div>

<style>
  .ctas {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }
</style>
