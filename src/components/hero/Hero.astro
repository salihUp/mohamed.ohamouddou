---
import type { Locale } from '~/i18n';
import HeroGreeting from './HeroGreeting.astro';
import HeroHeading from './HeroHeading.astro';
import HeroDescription from './HeroDescription.astro';
import HeroCTAs from './HeroCTAs.astro';
import HeroPortrait from './HeroPortrait.astro';

interface CTA {
  label: string;
  href: string;
}

interface Props {
  locale: Locale;
  greeting: string;
  before?: string;
  accent: string;
  after: string;
  description: string;
  primaryCTA: CTA;
  secondaryCTA: CTA;
  portrait: string;
  portraitAlt: string;
}

const {
  greeting,
  before = '',
  accent,
  after,
  description,
  primaryCTA,
  secondaryCTA,
  portrait,
  portraitAlt,
} = Astro.props;
---

<section class="hero">
  <div class="hero-blob" aria-hidden="true"></div>
  <div class="container-prose hero-grid">
    <div class="hero-text">
      <div class="anim-rise" style="--anim-delay: 0ms">
        <HeroGreeting text={greeting} />
      </div>
      <div class="anim-rise" style="--anim-delay: 90ms">
        <HeroHeading before={before} accent={accent} after={after} />
      </div>
      <div class="anim-rise" style="--anim-delay: 220ms">
        <HeroDescription text={description} />
      </div>
      <div class="anim-rise" style="--anim-delay: 320ms">
        <HeroCTAs primary={primaryCTA} secondary={secondaryCTA} />
      </div>
    </div>
    <div class="hero-portrait anim-rise" style="--anim-delay: 140ms">
      <div class="hero-float">
        <HeroPortrait src={portrait} alt={portraitAlt} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 5vw, 4rem);
    overflow: hidden;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    min-height: calc(100dvh - 4.5rem - 2rem);
  }
  .hero-text { order: 2; }
  .hero-portrait { order: 1; }

  /* Subtle floating decoration behind heading */
  .hero-blob {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .hero-blob::before {
    content: '';
    position: absolute;
    top: 8%;
    left: -8%;
    width: 38vw;
    max-width: 540px;
    aspect-ratio: 1 / 1;
    background: radial-gradient(circle at 50% 50%,
      color-mix(in srgb, var(--color-accent) 18%, transparent) 0%,
      color-mix(in srgb, var(--color-accent) 8%, transparent) 35%,
      transparent 70%);
    filter: blur(40px);
    border-radius: 50%;
    animation: pulse-blob 11s ease-in-out infinite;
    will-change: transform, opacity;
  }

  /* Gentle floating animation on portrait wrapper */
  .hero-float {
    animation: float-y 7s ease-in-out infinite;
    animation-delay: 800ms;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-blob::before { animation: none; }
    .hero-float { animation: none; }
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4rem;
    }
    .hero-text { order: 1; }
    .hero-portrait { order: 2; }
  }
</style>
