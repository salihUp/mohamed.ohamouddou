---
import { Icon } from 'astro-icon/components';
import type { Locale } from '~/i18n';
import { tString } from '~/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-prose footer-inner">
    <p class="copy">{tString(locale, 'footer.copyright', { year })}</p>

    <div class="socials" aria-label="Social links">
      <a href="mailto:ohamouddou3@gmail.com" aria-label="Email">
        <Icon name="lucide:mail" width="18" height="18" />
      </a>
      <a href="https://scholar.google.com/citations?user=sC7xPz0AAAAJ&hl=en" target="_blank" rel="me noreferrer" aria-label="Google Scholar">
        <Icon name="simple-icons:googlescholar" width="18" height="18" />
      </a>
      <a href="https://linkedin.com/in/mohamed-ohamouddou-641246131" target="_blank" rel="me noreferrer" aria-label="LinkedIn">
        <Icon name="simple-icons:linkedin" width="18" height="18" />
      </a>
      <a href="https://orcid.org/0009-0000-9369-2891" target="_blank" rel="me noreferrer" aria-label="ORCID">
        <Icon name="simple-icons:orcid" width="18" height="18" />
      </a>
    </div>

    <p class="meta">{tString(locale, 'footer.built')}</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    margin-top: 6rem;
    padding-block: 2.5rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-ink-soft);
    font-size: 0.85rem;
  }
  .socials {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }
  .socials a {
    color: var(--color-ink-soft);
    transition: color 180ms ease;
  }
  .socials a:hover { color: var(--color-ink); }
  .meta { font-size: 0.78rem; color: var(--color-muted); }
</style>
