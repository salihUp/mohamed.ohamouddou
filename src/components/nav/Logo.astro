---
import type { Locale } from '~/i18n';
import { localizedPath } from '~/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const href = localizedPath('/', locale);
---

<a href={href} class="logo" aria-label="Mohamed Ohamouddou">
  <span class="first">Mohamed</span>
  <span class="last">Ohamouddou</span><span class="dot">.</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.32em;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    letter-spacing: -0.028em;
    color: var(--color-ink);
    white-space: nowrap;
    line-height: 1;
    transition: color 180ms ease;
  }
  .first {
    font-weight: 400;
    color: var(--color-ink-soft);
    transition: color 180ms ease;
  }
  .last {
    font-weight: 700;
    color: var(--color-ink);
  }
  .dot {
    color: var(--color-accent);
    margin-left: -0.1em;
    font-weight: 700;
  }
  .logo:hover .first { color: var(--color-ink); }

  @media (max-width: 540px) {
    .logo { font-size: 0.92rem; gap: 0.28em; }
  }
  @media (max-width: 400px) {
    .first { display: none; }
  }
</style>
