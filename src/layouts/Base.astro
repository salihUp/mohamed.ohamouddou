---
import '~/styles/global.css';
import type { Locale } from '~/i18n';
import { htmlLang, tString, switchLocalePath } from '~/i18n';
import NavBar from '~/components/nav/NavBar.astro';
import Footer from '~/components/Footer.astro';
import { personJsonLd } from '~/lib/seo';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { locale, title, description, ogImage, noindex = false } = Astro.props;

const pageTitle = title ?? tString(locale, 'site.title');
const pageDesc = description ?? tString(locale, 'site.description');
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const altLocalePath = switchLocalePath(Astro.url.pathname, locale === 'fr' ? 'en' : 'fr');
const altLocaleHref = new URL(altLocalePath, Astro.site ?? Astro.url.origin).toString();

const ogImg = new URL(ogImage ?? `${import.meta.env.BASE_URL}og-default.svg`, Astro.site ?? Astro.url.origin).toString();

const personLd = personJsonLd({
  name: 'Mohamed Ohamouddou',
  url: canonical,
  jobTitle: 'Adjunct Lecturer & Researcher',
  affiliation: 'Université',
  sameAs: [
    'https://scholar.google.com/citations?user=sC7xPz0AAAAJ&hl=en',
    'https://orcid.org/0009-0000-9369-2891',
    'https://linkedin.com/in/mohamed-ohamouddou-641246131',
  ],
});
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === 'fr' ? 'en' : 'fr'} href={altLocaleHref} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={htmlLang(locale)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImg} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImg} />

    <script type="application/ld+json" set:html={personLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <NavBar locale={locale} pathname={Astro.url.pathname} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      // Scroll-reveal: any [data-reveal] element fades+rises when entering viewport.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (items.length > 0 && !reduce) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => {
          el.classList.add('reveal');
          io.observe(el);
        });
      } else if (reduce) {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <style>
      .skip-link {
        position: absolute;
        top: -40px;
        left: 0;
        padding: 0.5rem 0.75rem;
        background: var(--color-ink);
        color: #fff;
        z-index: 100;
        border-radius: 0 0 8px 0;
      }
      .skip-link:focus { top: 0; }
    </style>
  </body>
</html>
